{
  "entities": {
    "Portfolio": {
      "title": "Portfolio",
      "description": "Public portfolio profile, experiences, education, skills, and projects",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "titles": { "type": "array" },
        "heroIntro": { "type": "string", "maxLength": 1000 },
        "profilePhoto": { "type": "string", "maxLength": 1000000 },
        "cvUrl": { "type": "string", "maxLength": 1000000 },
        "cvFileName": { "type": "string", "maxLength": 100 },
        "aboutBio": { "type": "array" },
        "careerObjectives": { "type": "array" },
        "stats": { "type": "array" },
        "experiences": { "type": "array" },
        "education": { "type": "array" },
        "skills": { "type": "array" },
        "certificates": { "type": "array" },
        "projects": { "type": "array" },
        "contact": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "titles", "heroIntro"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Visitor contact inquiries sent through the portfolio website",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "minLength": 5, "maxLength": 150 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 200 },
        "message": { "type": "string", "minLength": 5, "maxLength": 3000 },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["name", "email", "subject", "message", "timestamp"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator user profile",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/portfolio/{portfolioId}": {
      "schema": { "$ref": "#/entities/Portfolio" },
      "description": "Portfolio content and configuration document"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Contact form submissions from prospective recruiters and clients"
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Designated administrator UID entries"
    }
  }
}
